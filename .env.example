# Hydros Docker Environment Configuration
# Copy this file to .env and modify as needed

# Hydros System Configuration
SITE_ID=wtp-porto-01
HYDROS_MODE=simulation
LOG_LEVEL=INFO

# PLC Configuration
PLC_HOST=localhost
PLC_PORT=5020

# MQTT Configuration (handled by docker network)
# MQTT_HOST=mosquitto
# MQTT_PORT=1883

# InfluxDB Configuration
INFLUXDB_TOKEN=hydros-token
INFLUXDB_ORG=hydros
INFLUXDB_BUCKET=wtp
INFLUXDB_URL=http://localhost:8086
AGGREGATION_PUBLISH_INTERVAL=300
# Hydros Docker Environment Configuration
# Copy this file to .env and modify as needed

# Hydros System Configuration
SITE_ID=wtp-porto-01
HYDROS_MODE=simulation
LOG_LEVEL=INFO

# PLC Configuration
PLC_HOST=localhost
PLC_PORT=5020

# MQTT Configuration (handled by docker network)
# MQTT_HOST=mosquitto
# MQTT_PORT=1883

# InfluxDB Configuration
INFLUX_TOKEN=hydros-token
INFLUX_ORG=hydros
INFLUX_BUCKET=wtp
